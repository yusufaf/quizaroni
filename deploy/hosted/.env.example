# Copy to .env next to compose.yaml. Compose reads this file twice: to fill
# ${...} in compose.yaml, and as the app's env_file.

# Pin a release in production.
QUIZARONI_IMAGE=ghcr.io/yusufaf/quizaroni-hosted:0.6.0

# ---- First boot after the import ----
# Add these only after `quizaroni import --admin <email>` has run: a boot with
# them before the import creates an admin, and the import then refuses. After
# the import they only mark setup complete and fill the registration settings;
# the email and password aren't used, but they must still be a valid email and
# an 8-128 character password, or the server exits on boot. Delete them after
# the first boot.
# QZ_ADMIN_EMAIL=
# QZ_ADMIN_PASSWORD=
# QZ_REGISTRATION_MODE=open
# QZ_TEACHER_POLICY=admin_approved

# ---- SMTP (password resets and invites) ----
# Compose expands $ in this file, so wrap any value containing $ in single
# quotes, e.g. QZ_SMTP_PASSWORD='...'. The hosted instance uses Amazon SES;
# its user and password are SES SMTP credentials for a sender scoped to
# ses:SendRawEmail on the quizaroni.yusufaf.dev identity.
QZ_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
QZ_SMTP_PORT=587
QZ_SMTP_SECURITY=starttls
QZ_SMTP_USER=
QZ_SMTP_PASSWORD=
QZ_SMTP_FROM='Quizaroni <no-reply@quizaroni.yusufaf.dev>'

# ---- New sign-up notices ----
# Email this address whenever someone creates an account (needs the SMTP
# settings above). Off when blank.
# QZ_SIGNUP_NOTIFY_EMAIL=

# ---- Sign in with Google or GitHub ----
# Each provider needs both its id and its secret; leave both blank to turn it
# off. New accounts can sign up with them only while registration is open; an
# existing account links only if its email is verified (admin, imported).
# Google: add <public URL>/api/auth/callback/google as an authorized redirect URI.
QZ_GOOGLE_CLIENT_ID=
QZ_GOOGLE_CLIENT_SECRET=
# GitHub: set the OAuth App's callback URL to <public URL>/api/auth/callback/github.
QZ_GITHUB_CLIENT_ID=
QZ_GITHUB_CLIENT_SECRET=
