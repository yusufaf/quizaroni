{$SITE_ADDRESS:quizaroni.yusufaf.dev} {
	encode zstd gzip

	# Umami, proxied same-origin so ad blockers see first-party requests,
	# under /q since the server owns /api (#270).
	@umami path /q/s.js /q/api/e
	handle @umami {
		uri strip_prefix /q
		reverse_proxy https://analytics.yusufaf.dev
	}

	handle {
		reverse_proxy quizaroni:8080
	}
}
