# Frontend environment variables (Vite — must be prefixed with VITE_ to be exposed).

# Shows the Publish to Explore entry point.
# VITE_FEATURE_PUBLISH=false

# Umami analytics. The <script> tag is emitted only when both the website id
# and src are set. The hosted image sets these in
# .github/workflows/hosted-image.yml; the stock build leaves them unset.
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=
# VITE_UMAMI_HOST_URL=
