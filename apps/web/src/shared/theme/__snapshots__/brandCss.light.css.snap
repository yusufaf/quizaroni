/* CreateSetStyles.NewCard */
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);border-radius:4px;box-shadow:0px 2px 1px -1px rgba(0,0,0,51),0px 1px 1px 0px rgba(0,0,0,36),0px 1px 3px 0px rgba(0,0,0,31);background-image:none;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,20),0 0.0625rem 0.25rem rgba(0,0,0,10);box-shadow:0 0.25rem 1rem rgba(0,0,0,20),0 0.125rem 0.5rem rgba(0,0,0,10);border:1px solid rgba(0,0,0,15);border-radius:0.75rem;box-shadow:0 0.25rem 0.75rem rgba(255,160,0,38)}
&:hover{box-shadow:0 0.5rem 1.5rem rgba(255,160,0,38),0 0.25rem 0.75rem rgba(0,0,0,20)}
&:hover{box-shadow:0 0.375rem 1rem rgba(255,160,0,64)}

/* HomeStyles.HomePage */
&{background:linear-gradient(to bottom, rgba(245,245,247,255), rgba(245,245,245,255))}

/* ImportCardsModal.DropOverlay */
@keyframes pulse{0%,100%{background-color:rgba(245,245,245,242)}50%{background-color:rgba(25,118,210,20)}}
@keyframes pulse{0%,100%{background-color:rgba(245,245,245,242)}50%{background-color:rgba(25,118,210,20)}}
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);border-radius:4px;box-shadow:0px 2px 1px -1px rgba(0,0,0,51),0px 1px 1px 0px rgba(0,0,0,36),0px 1px 3px 0px rgba(0,0,0,31);background-image:none;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,20),0 0.0625rem 0.25rem rgba(0,0,0,10);background-color:rgba(245,245,245,242);border-radius:0.5rem}
@keyframes pulse{0%,100%{background-color:rgba(245,245,245,242)}50%{background-color:rgba(25,118,210,20)}}
@keyframes pulse{0%,100%{background-color:rgba(245,245,245,242)}50%{background-color:rgba(25,118,210,20)}}

/* ImportCardsModal.StyledTextarea */
&{background-color:rgba(245,245,245,255);color:rgba(30,30,30,255);border:2px dashed rgba(0,0,0,31);border-radius:0.5rem;outline:none}
&:focus{border-color:rgba(255,160,0,255);box-shadow:0 0 0 2px rgba(255,160,0,51)}
&::selection{background-color:rgba(255,160,0,68)}

/* ImportCardsModal.StyledTextarea.dragging */
&{background-color:rgba(245,245,245,255);color:rgba(30,30,30,255);border:2px dashed rgba(255,160,0,255);border-radius:0.5rem;outline:none}
&:focus{border-color:rgba(255,160,0,255);box-shadow:0 0 0 2px rgba(255,160,0,51)}
&::selection{background-color:rgba(255,160,0,68)}

/* ImportCardsModal.StyledTextarea.error */
&{background-color:rgba(245,245,245,255);color:rgba(30,30,30,255);border:2px dashed rgba(211,47,47,255);border-radius:0.5rem;outline:none}
&:focus{border-color:rgba(211,47,47,255);box-shadow:0 0 0 2px rgba(211,47,47,51)}
&::selection{background-color:rgba(255,160,0,68)}

/* JsonSettingsTab.ErrorList */
&{background-color:rgba(254,242,242,255);border:1px solid rgba(211,47,47,255);border-radius:0.25rem}

/* JsonSettingsTab.StyledTextarea */
&{background-color:rgba(245,245,245,255);color:rgba(30,30,30,255);border:1px solid rgba(0,0,0,31);border-radius:0.5rem;outline:none}
&:focus{border-color:rgba(255,160,0,255);box-shadow:0 0 0 2px rgba(255,160,0,51)}
&::selection{background-color:rgba(255,160,0,68)}

/* JsonSettingsTab.StyledTextarea.error */
&{background-color:rgba(245,245,245,255);color:rgba(30,30,30,255);border:1px solid rgba(211,47,47,255);border-radius:0.5rem;outline:none}
&:focus{border-color:rgba(211,47,47,255);box-shadow:0 0 0 2px rgba(211,47,47,51)}
&::selection{background-color:rgba(255,160,0,68)}

/* NavStyles.CreateStudySetButton */
&{-webkit-tap-highlight-color:transparent;background-color:transparent;outline:0;border:0;border-radius:0;color:inherit;border-radius:4px;color:rgba(0,0,0,255);background-color:rgba(255,160,0,255);box-shadow:0px 3px 1px -2px rgba(0,0,0,51),0px 2px 2px 0px rgba(0,0,0,36),0px 1px 5px 0px rgba(0,0,0,31);border-radius:0.5rem;color:rgba(0,0,0,255);background-color:rgba(255,160,0,255);box-shadow:0 0.125rem 0.5rem rgba(255,160,0,77);border-radius:2rem;box-shadow:0 0.125rem 0.5rem rgba(255,160,0,77)}
&::-moz-focus-inner{border-style:none}
@media print{&{-webkit-print-color-adjust:exact;color-adjust:exact}}
&:hover{background-color:rgba(198,113,0,255);box-shadow:0px 2px 4px -1px rgba(0,0,0,51),0px 4px 5px 0px rgba(0,0,0,36),0px 1px 10px 0px rgba(0,0,0,31)}
@media (hover: none){&:hover{background-color:rgba(255,160,0,255)}}
&:active{box-shadow:0px 5px 5px -3px rgba(0,0,0,51),0px 8px 10px 1px rgba(0,0,0,36),0px 3px 14px 2px rgba(0,0,0,31)}
&.Mui-focusVisible{box-shadow:0px 3px 5px -1px rgba(0,0,0,51),0px 6px 10px 0px rgba(0,0,0,36),0px 1px 18px 0px rgba(0,0,0,31)}
&.Mui-disabled{color:rgba(0,0,0,66);box-shadow:none;background-color:rgba(0,0,0,31)}
&:hover{color:rgba(0,0,0,255);background-color:rgba(255,143,0,255);box-shadow:0 0.375rem 1rem rgba(255,160,0,89)}
&:active{box-shadow:0 0.125rem 0.25rem rgba(255,160,0,51)}
&:hover{box-shadow:0 0.25rem 0.75rem rgba(255,160,0,102)}

/* NavStyles.StyledNavLink */
&{border-radius:2rem;color:rgba(0,0,0,153)}
&:hover{color:rgba(0,0,0,222);background-color:rgba(255,160,0,20)}
&.active{color:rgba(255,160,0,255);background-color:rgba(255,160,0,20)}

/* NavStyles.activeNavLinkSx */
&{border-radius:0.5rem;color:rgba(0,0,0,153)}
&.active{color:rgba(255,160,0,255);background-color:rgba(255,160,0,20)}

/* StudyHeader.appBar */
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);box-shadow:0px 2px 4px -1px rgba(0,0,0,51),0px 4px 5px 0px rgba(0,0,0,36),0px 1px 10px 0px rgba(0,0,0,31);background-image:none;background-color:rgba(255,160,0,255);color:rgba(0,0,0,255);background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);box-shadow:0px 3px 1px -2px rgba(0,0,0,51),0px 2px 2px 0px rgba(0,0,0,36),0px 1px 5px 0px rgba(0,0,0,31);border-top:1px solid rgba(255,160,0,51)}

/* StudyHeader.scorePill */
&{border-radius:1.5rem;background-color:rgba(255,160,0,26);border:0.0625rem solid rgba(255,160,0,77)}

/* StudysetSettings.CustomInputsContainer */
&{border-left:0.1875rem solid;border-color:rgba(255,160,0,77);background-color:rgba(255,160,0,13);border-radius:0.25rem}

/* ViewStudySet.StudyModePaper */
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);border-radius:4px;box-shadow:0px 2px 1px -1px rgba(0,0,0,51),0px 1px 1px 0px rgba(0,0,0,36),0px 1px 3px 0px rgba(0,0,0,31);background-image:none;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,20),0 0.0625rem 0.25rem rgba(0,0,0,10);box-shadow:0 0.125rem 0.5rem rgba(0,0,0,15);border:1px solid rgba(0,0,0,20)}
&:hover{background:rgba(255,160,0,20);box-shadow:0 0.375rem 1rem rgba(255,160,0,31),0 0.125rem 0.5rem rgba(0,0,0,15)}

/* ViewStudySet.ViewFlashsetCard */
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);border-radius:4px;box-shadow:0px 2px 1px -1px rgba(0,0,0,51),0px 1px 1px 0px rgba(0,0,0,36),0px 1px 3px 0px rgba(0,0,0,31);background-image:none;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,20),0 0.0625rem 0.25rem rgba(0,0,0,10);box-shadow:0 0.25rem 1rem rgba(0,0,0,20),0 0.125rem 0.5rem rgba(0,0,0,10);border:1px solid rgba(0,0,0,15);border-radius:0.75rem;box-shadow:0 0.25rem 1rem rgba(0,0,0,20),0 0.125rem 0.5rem rgba(0,0,0,10);border:1px solid rgba(0,0,0,15)}
&:hover{box-shadow:0 0.5rem 1.5rem rgba(255,160,0,38),0 0.25rem 0.75rem rgba(0,0,0,20)}
&:hover{box-shadow:0 0.5rem 1.5rem rgba(255,160,0,31),0 0.25rem 0.75rem rgba(0,0,0,20)}

/* ViewStudySet.ViewGridCard */
&{background-color:rgba(255,255,255,255);color:rgba(0,0,0,222);border-radius:4px;box-shadow:0px 2px 1px -1px rgba(0,0,0,51),0px 1px 1px 0px rgba(0,0,0,36),0px 1px 3px 0px rgba(0,0,0,31);background-image:none;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,20),0 0.0625rem 0.25rem rgba(0,0,0,10);box-shadow:0 0.25rem 1rem rgba(0,0,0,20),0 0.125rem 0.5rem rgba(0,0,0,10);border:1px solid rgba(0,0,0,15);border-radius:0.75rem;box-shadow:0 0.25rem 1rem rgba(0,0,0,20),0 0.125rem 0.5rem rgba(0,0,0,10);border:1px solid rgba(0,0,0,15)}
&:hover{box-shadow:0 0.5rem 1.5rem rgba(255,160,0,38),0 0.25rem 0.75rem rgba(0,0,0,20)}
&:hover{box-shadow:0 0.5rem 1.5rem rgba(255,160,0,31),0 0.25rem 0.75rem rgba(0,0,0,20)}

/* ViewStudysetFilters.countPill */
&{border-radius:1.5rem;background-color:rgba(255,160,0,26);border:0.0625rem solid rgba(255,160,0,77)}
