{
  "breakpoints": {
    "between": "[Function]",
    "down": "[Function]",
    "keys": [
      "xs",
      "sm",
      "md",
      "lg",
      "xl"
    ],
    "not": "[Function]",
    "only": "[Function]",
    "unit": "px",
    "up": "[Function]",
    "values": {
      "lg": 1200,
      "md": 900,
      "sm": 600,
      "xl": 1536,
      "xs": 0
    }
  },
  "components": {
    "MuiButton": {
      "styleOverrides": {
        "contained": {
          "&:active": {
            "boxShadow": "0 0.125rem 0.25rem rgba(255, 160, 0, 0.2)",
            "transform": "translateY(0)"
          },
          "&:hover": {
            "backgroundColor": "#ff8f00",
            "boxShadow": "0 0.375rem 1rem rgba(255, 160, 0, 0.35)",
            "color": "#000000",
            "transform": "translateY(-1px)"
          },
          "backgroundColor": "#ffa000",
          "boxShadow": "0 0.125rem 0.5rem rgba(255, 160, 0, 0.3)",
          "color": "#000000",
          "fontWeight": 600
        },
        "outlined": {
          "&:hover": {
            "backgroundColor": "#ffa000",
            "borderColor": "#ffa000",
            "boxShadow": "0 0.125rem 0.5rem rgba(255, 160, 0, 0.2)",
            "color": "#000000"
          },
          "borderColor": "#c67100",
          "color": "#c67100",
          "fontWeight": 600
        },
        "root": {
          "borderRadius": "0.5rem",
          "textTransform": "none",
          "transition": "all 0.2s ease"
        },
        "text": {
          "&:hover": {
            "backgroundColor": "rgba(255, 160, 0, 0.1)"
          },
          "color": "#c67100",
          "fontWeight": 600
        }
      }
    },
    "MuiCard": {
      "styleOverrides": {
        "root": {
          "&:hover": {
            "boxShadow": "0 0.5rem 1.5rem rgba(255, 160, 0, 0.15), 0 0.25rem 0.75rem rgba(0, 0, 0, 0.08)"
          },
          "border": "1px solid rgba(0, 0, 0, 0.06)",
          "boxShadow": "0 0.25rem 1rem rgba(0, 0, 0, 0.08), 0 0.125rem 0.5rem rgba(0, 0, 0, 0.04)"
        }
      }
    },
    "MuiChip": {
      "styleOverrides": {
        "outlined": {
          "borderColor": "rgba(0, 0, 0, 0.23)"
        }
      }
    },
    "MuiCssBaseline": {
      "styleOverrides": {
        "body": {
          "backgroundColor": "#f5f5f7"
        }
      }
    },
    "MuiDataGrid": {
      "styleOverrides": {
        "toolbarContainer": {
          "& .MuiButton-text": {
            "color": "#c67100"
          }
        }
      }
    },
    "MuiIconButton": {
      "styleOverrides": {
        "root": {
          "&.MuiIconButton-colorPrimary": {
            "color": "#ffa000"
          },
          "&:hover": {
            "backgroundColor": "rgba(255, 160, 0, 0.08)",
            "color": "#c67100"
          },
          "color": "rgba(0, 0, 0, 0.7)"
        }
      }
    },
    "MuiPaper": {
      "styleOverrides": {
        "elevation1": {
          "boxShadow": "0 0.125rem 0.5rem rgba(0, 0, 0, 0.08), 0 0.0625rem 0.25rem rgba(0, 0, 0, 0.04)"
        },
        "elevation2": {
          "boxShadow": "0 0.25rem 0.75rem rgba(0, 0, 0, 0.1), 0 0.125rem 0.375rem rgba(0, 0, 0, 0.06)"
        },
        "elevation3": {
          "boxShadow": "0 0.375rem 1rem rgba(0, 0, 0, 0.12), 0 0.1875rem 0.5rem rgba(0, 0, 0, 0.08)"
        },
        "elevation6": {
          "boxShadow": "0 0.5rem 1.5rem rgba(0, 0, 0, 0.12), 0 0.25rem 0.75rem rgba(0, 0, 0, 0.08)"
        },
        "root": {
          "backgroundImage": "none"
        }
      }
    },
    "MuiSelect": {
      "styleOverrides": {
        "root": {
          "& .MuiOutlinedInput-notchedOutline": {
            "borderColor": "rgba(0, 0, 0, 0.23)"
          }
        }
      }
    },
    "MuiTab": {
      "styleOverrides": {
        "root": {
          "&.Mui-selected": {
            "color": "#c67100"
          }
        }
      }
    }
  },
  "direction": "ltr",
  "mixins": {
    "toolbar": {
      "@media (min-width:0px)": {
        "@media (orientation: landscape)": {
          "minHeight": 48
        }
      },
      "@media (min-width:600px)": {
        "minHeight": 64
      },
      "minHeight": 56
    }
  },
  "palette": {
    "action": {
      "activatedOpacity": 0.12,
      "active": "rgba(0, 0, 0, 0.7)",
      "disabled": "rgba(0, 0, 0, 0.26)",
      "disabledBackground": "rgba(0, 0, 0, 0.12)",
      "disabledOpacity": 0.38,
      "focus": "rgba(0, 0, 0, 0.12)",
      "focusOpacity": 0.12,
      "hover": "rgba(255, 160, 0, 0.08)",
      "hoverOpacity": 0.04,
      "selected": "rgba(255, 160, 0, 0.16)",
      "selectedOpacity": 0.08
    },
    "augmentColor": "[Function]",
    "background": {
      "default": "#f5f5f7",
      "paper": "#ffffff"
    },
    "common": {
      "black": "#000",
      "white": "#fff"
    },
    "contrastThreshold": 3,
    "divider": "rgba(0, 0, 0, 0.12)",
    "error": {
      "contrastText": "#fff",
      "dark": "#c62828",
      "light": "#ef5350",
      "main": "#d32f2f"
    },
    "getContrastText": "[Function]",
    "grey": {
      "50": "#fafafa",
      "100": "#f5f5f5",
      "200": "#eeeeee",
      "300": "#e0e0e0",
      "400": "#bdbdbd",
      "500": "#9e9e9e",
      "600": "#757575",
      "700": "#616161",
      "800": "#424242",
      "900": "#212121",
      "A100": "#f5f5f5",
      "A200": "#eeeeee",
      "A400": "#bdbdbd",
      "A700": "#616161"
    },
    "info": {
      "contrastText": "#fff",
      "dark": "#01579b",
      "light": "#03a9f4",
      "main": "#0288d1"
    },
    "mode": "light",
    "other": {
      "gold": {
        "main": "#FFDF00"
      },
      "primaryText": "#9a5500"
    },
    "primary": {
      "contrastText": "#000000",
      "dark": "#c67100",
      "light": "#ffd149",
      "main": "#ffa000"
    },
    "secondary": {
      "contrastText": "#fff",
      "dark": "#1c313a",
      "light": "#718792",
      "main": "#455a64"
    },
    "success": {
      "contrastText": "#fff",
      "dark": "#1b5e20",
      "light": "#4caf50",
      "main": "#2e7d32"
    },
    "text": {
      "disabled": "rgba(0, 0, 0, 0.38)",
      "primary": "rgba(0, 0, 0, 0.87)",
      "secondary": "rgba(0, 0, 0, 0.6)"
    },
    "tonalOffset": 0.2,
    "warning": {
      "contrastText": "#fff",
      "dark": "#e65100",
      "light": "#ff9800",
      "main": "#ed6c02"
    }
  },
  "shadows": [
    "none",
    "0px 2px 1px -1px rgba(0,0,0,0.2),0px 1px 1px 0px rgba(0,0,0,0.14),0px 1px 3px 0px rgba(0,0,0,0.12)",
    "0px 3px 1px -2px rgba(0,0,0,0.2),0px 2px 2px 0px rgba(0,0,0,0.14),0px 1px 5px 0px rgba(0,0,0,0.12)",
    "0px 3px 3px -2px rgba(0,0,0,0.2),0px 3px 4px 0px rgba(0,0,0,0.14),0px 1px 8px 0px rgba(0,0,0,0.12)",
    "0px 2px 4px -1px rgba(0,0,0,0.2),0px 4px 5px 0px rgba(0,0,0,0.14),0px 1px 10px 0px rgba(0,0,0,0.12)",
    "0px 3px 5px -1px rgba(0,0,0,0.2),0px 5px 8px 0px rgba(0,0,0,0.14),0px 1px 14px 0px rgba(0,0,0,0.12)",
    "0px 3px 5px -1px rgba(0,0,0,0.2),0px 6px 10px 0px rgba(0,0,0,0.14),0px 1px 18px 0px rgba(0,0,0,0.12)",
    "0px 4px 5px -2px rgba(0,0,0,0.2),0px 7px 10px 1px rgba(0,0,0,0.14),0px 2px 16px 1px rgba(0,0,0,0.12)",
    "0px 5px 5px -3px rgba(0,0,0,0.2),0px 8px 10px 1px rgba(0,0,0,0.14),0px 3px 14px 2px rgba(0,0,0,0.12)",
    "0px 5px 6px -3px rgba(0,0,0,0.2),0px 9px 12px 1px rgba(0,0,0,0.14),0px 3px 16px 2px rgba(0,0,0,0.12)",
    "0px 6px 6px -3px rgba(0,0,0,0.2),0px 10px 14px 1px rgba(0,0,0,0.14),0px 4px 18px 3px rgba(0,0,0,0.12)",
    "0px 6px 7px -4px rgba(0,0,0,0.2),0px 11px 15px 1px rgba(0,0,0,0.14),0px 4px 20px 3px rgba(0,0,0,0.12)",
    "0px 7px 8px -4px rgba(0,0,0,0.2),0px 12px 17px 2px rgba(0,0,0,0.14),0px 5px 22px 4px rgba(0,0,0,0.12)",
