# ---- CDK deploy target ----
account=123456789012
region=us-west-2
appName=quizaroni
# development | production
deploymentType=development

# ---- Logto webhook (Console > Webhooks > "Quizaroni user created", event
# User.Created) — the signing key Logto generates when the webhook is
# created. logtoUserCreatedWebhook.ts verifies the logto-signature-sha-256
# header against this key so the endpoint can't be spoofed.
LOGTO_WEBHOOK_SIGNING_KEY=

# ---- Logto Management API (M2M) ----
# Console > Applications > Machine-to-machine, with the role "Logto Management
# API access". updateUsername.ts uses it to change a user's username.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ---- CORS ----
# Comma-separated extra origins allowed by the API (localhost is always allowed)
ALLOWED_ORIGINS=https://your-frontend.example.com
